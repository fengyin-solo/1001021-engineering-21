# ===== 本地开发环境变量示例 =====
# 复制为 .env 后按需修改：cp .env.example .env
# 所有项都有默认值，本地开发一个都不配也能直接 `make dev` 跑起来。

# 运行环境：local / dev / staging / production / prod / test
APP_ENV=local

# 后端监听地址与端口（前端 vite 默认代理到 127.0.0.1:8000）
APP_HOST=127.0.0.1
APP_PORT=8000

# 应用名称（健康检查/页面标题用）
APP_NAME=市政道路桥梁养护管理平台

# 允许跨域来源，多个用英文逗号分隔；默认放行本地前端 5173
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
