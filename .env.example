# 本地开发环境变量样例：复制为 .env 后按需修改。
# 全部变量在 APP_ENV=local 时都有默认值，clone 下来不配也能启动；
# 非 local 环境（如 APP_ENV=prod）必须提供 APP_SECRET_KEY，否则启动预检直接报错。

# 运行环境：local 使用内置默认值；其他值要求显式配置 APP_SECRET_KEY
APP_ENV=local

# 非 local 环境必填：会话/签名用的密钥，本地可留空
APP_SECRET_KEY=

# 后端监听端口（默认 8000）
APP_PORT=8000

# 允许跨域的前端来源，逗号分隔（默认 http://127.0.0.1:5173,http://localhost:5173）
APP_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 前端 dev/preview 代理指向的后端地址（默认 http://127.0.0.1:8000）
VITE_PROXY_TARGET=http://127.0.0.1:8000
